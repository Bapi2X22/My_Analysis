executable = /eos/home-b/bbapi/My_Analysis/2024_efficiency_study/Process_BDT/run_training.sh

arguments = $(ARGS)

output = BDT_Training.$(ClusterId).$(ProcId).out
error  = BDT_Training.$(ClusterId).$(ProcId).err
log    = condor_BDT_Training/BDT_Training.$(ClusterId).log

output_destination = root://eosuser.cern.ch//eos/user/b/bbapi/My_Analysis/2024_efficiency_study/Process_BDT/condor_logs/BDT_Training

getenv = True
use_x509userproxy = true

request_cpus = 4
request_memory = 16384
request_disk = 20000

+JobFlavour = "workday"

+BDTTraining = "Process_BDT"

on_exit_remove = (ExitBySignal == False) && (ExitCode == 0)
on_exit_hold = (ExitBySignal == True) || (ExitCode != 0)

periodic_hold = (JobStatus == 7) && ((CurrentTime - EnteredCurrentStatus) > 300)
periodic_hold_reason = "Job stuck suspended >5m"

periodic_release = (JobStatus == 5) && ((CurrentTime - EnteredCurrentStatus) > 60)

max_retries = 3

requirements = Machine =!= LastRemoteHost

should_transfer_files = YES
when_to_transfer_output = ON_EXIT

transfer_input_files = /eos/home-b/bbapi/My_Analysis/2024_efficiency_study/Process_BDT/xgboost_TrainMVA_v2_withWeight_mod_condor.py,/eos/home-b/bbapi/My_Analysis/2024_efficiency_study/Process_BDT/Merged_Inputs

queue ARGS from condor_BDT_Training/arguments.txt
